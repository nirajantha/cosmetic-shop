# MySQL connection string.
# Local dev options: XAMPP/MAMP, Docker (`docker run -e MYSQL_ROOT_PASSWORD=... mysql:8`),
# or your cPanel host's own MySQL database (create it under "MySQL Databases").
DATABASE_URL="mysql://user:password@localhost:3306/cosmetic_store"

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# Public base URL of the deployed site (used for canonical URLs, sitemaps, JSON-LD, OG images).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp Business number that receives orders, in international format, digits only (no +, spaces, or dashes).
WHATSAPP_PHONE_NUMBER=97798XXXXXXXX

# Cloudinary (product image storage). Get these from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seeded admin user credentials (used once by `prisma/seed.ts` to create the initial AdminUser).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
