# PostgreSQL connection string.
# Local dev options: `npm run db:dev` (spins up a local Postgres via Prisma),
# Docker, or a free hosted instance (Neon, Supabase, Railway).
DATABASE_URL="postgresql://user:password@localhost:5432/cosmetic_store?schema=public"

# Auth.js — generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# Public base URL of the deployed site (used for canonical URLs, sitemaps, JSON-LD, OG images).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp Business number that receives orders, in international format, digits only (no +, spaces, or dashes).
WHATSAPP_PHONE_NUMBER=97798XXXXXXXX

# Cloudinary (product image storage). Get these from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seeded admin user credentials (used once by `prisma/seed.ts` to create the initial AdminUser).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
